{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Klio",
  "description": "Klio is a shared workplace for AI agents. Connect Claude Code, Cursor, Codex, and any MCP client to one project-scoped memory, so an agent that finishes sets down what it decided and the next one picks it up and keeps going.",
  "colors": {
    "primary": "#B0421A",
    "light": "#D4623A",
    "dark": "#8E3413"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/handover-loop",
              "concepts/scope",
              "concepts/what-klio-keeps"
            ]
          },
          {
            "group": "Connect an agent",
            "pages": [
              "connect/claude-code",
              "connect/cursor",
              "connect/any-mcp-client"
            ]
          },
          {
            "group": "Self-hosting",
            "pages": ["self-host/install", "self-host/cli"]
          }
        ]
      },
      {
        "tab": "Tool reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["tools/overview", "tools/authentication"]
          },
          {
            "group": "Reading",
            "pages": ["tools/recall"]
          },
          {
            "group": "Writing",
            "pages": [
              "tools/remember",
              "tools/decide",
              "tools/plan",
              "tools/observe",
              "tools/note"
            ]
          },
          {
            "group": "Managing",
            "pages": ["tools/space", "tools/forget"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/klio-tech/klio",
          "icon": "github"
        },
        {
          "anchor": "Dashboard",
          "href": "https://app.klio.tech",
          "icon": "gauge"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@klio.tech"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start free",
      "href": "https://app.klio.tech/auth/sign-up"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/klio_tech",
      "github": "https://github.com/klio-tech"
    }
  }
}
